{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.exists() && data.child('meta/teacherUid').val() === auth.uid && !newData.exists()",
        ".validate": "$code.matches(/^[0-9]{4}$/)",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('teacherUid').val() === auth.uid) || data.child('teacherUid').val() === auth.uid)"
        },
        "devices": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/meta').exists()"
          }
        },
        "teams": {
          "$t": {
            ".validate": "$t.matches(/^[1-6]$/)",
            "dev": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/meta').exists()"
              }
            }
          }
        },
        "samples": {
          "$t": {
            ".validate": "$t.matches(/^[1-6]$/)",
            "$id": {
              ".write": "auth != null && root.child('rooms/' + $code + '/meta').exists()",
              ".validate": "newData.hasChildren(['label', 'thumb', 'f', 'ff', 'kind', 'by']) && newData.child('thumb').isString() && newData.child('thumb').val().length < 20000 && newData.child('f').isString() && newData.child('f').val().length < 4000 && newData.child('ff').isString() && newData.child('ff').val().length < 4000 && newData.child('label').val().matches(/^(사람|자전거|킥보드|자동차)$/)"
            }
          }
        },
        "ethics": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/meta').exists()",
            ".validate": "newData.child('card').isNumber() && newData.child('reason').isString() && newData.child('reason').val().length <= 120"
          }
        },
        "poll": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/meta').exists()",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
          }
        }
      }
    }
  }
}
