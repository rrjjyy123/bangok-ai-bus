{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "map.osm",
      "tools/**",
      "*.md",
      "package.json"
    ],
    "headers": [
      { "source": "**/*.@(js|css|html|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "vendor/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "database": "(default)",
    "location": "asia-northeast3"
  },
  "auth": {
    "providers": {
      "anonymous": true
    }
  }
}
